# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Network Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
# Client-side (Public) - Required in frontend for Supabase Auth & Realtime
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Server-side (Secret) - Used in API routes / backend only, NEVER exposed to client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Database Connection (PostgreSQL / Supabase / Cloud SQL)
# When empty, VENDRA operates in high-integrity standalone mode with zero external blockers
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true

# Cryptographic and Session Secrets
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production
ADMIN_SECRET_KEY=vendra_admin_provisioning_key_2026

# Uganda Mobile Money Payment Gateway (MTN MoMo & Airtel Money)
MOMO_GATEWAY_API_KEY=
MOMO_GATEWAY_SECRET=
MOMO_WEBHOOK_SECRET=vendra_secure_webhook_secret_hmac_2026
MOMO_ENVIRONMENT=sandbox

# PesaPal v3 Payment Gateway Configuration
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENVIRONMENT=production
PESAPAL_IPN_ID=

