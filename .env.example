# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Network Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase / Bolt Cloud SQL)
# When empty, VENDRA uses its high-integrity local ACID file-backed relational ledger
DATABASE_URL=

# Cryptographic and Session Secrets
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production
ADMIN_SECRET_KEY=vendra_admin_provisioning_key_2026

# Uganda Mobile Money Payment Gateway (MTN MoMo & Airtel Money)
MOMO_GATEWAY_API_KEY=
MOMO_GATEWAY_SECRET=
MOMO_WEBHOOK_SECRET=vendra_secure_webhook_secret_hmac_2026
MOMO_ENVIRONMENT=sandbox

# PesaPal v3 Payment Gateway Configuration
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENVIRONMENT=production
PESAPAL_IPN_ID=

